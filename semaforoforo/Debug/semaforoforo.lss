                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; semaforoforo.asm
                                 ;
                                 ; Created: 07/10/2026 11:25:39
                                 ; Authors :
                                 
                                 
                                 ; Determina um segmento de código para a FLASH
                                 .cseg
                                 
                                 ; Manda PC para o endereço 0
                                 .org 0
                                 
                                 ; Define um registrador para armazenar o contador de estados
                                 .def state_count = r16
                                 .def serial_high = r17
                                 .def serial_low = r18
                                 
                                 ; Registrador auxiliar
                                 .def temp = r19
                                 .def temp2 = r20
                                 .def count_aux = r21
                                 
                                 ; Limite de estados
                                 .set state_limit = 12
                                 
                                 ; Pula para o inicializador do maldito programa
000000 940c 0027                 jmp reset
                                 
                                 ; Move o PC para o endereço da interrupção do timer
                                 .org OC1Aaddr
                                 ; Desvia para a subrotina de tratamento do timer
000016 c058                      rjmp OCI1A_Interrupt
                                 
                                 ; Move o PC para o endereço da interrupção de envio
                                 .org UDREaddr
                                 ; Desvia para a subrotina de tratamento de envio da serial
000026 c02e                      rjmp USART_UDRE_Interrupt
                                 
                                 ; ============================================================
                                 ; Inicia todos os parâmetros
                                 ; ============================================================
                                 reset:
                                 	; ---- Inicia a pilha para podermos utilizar subrotinas ----
000027 e038                      	ldi temp, high(RAMEND)
000028 bf3e                      	out SPH, temp
000029 ef3f                      	ldi temp, low(RAMEND)
00002a bf3d                      	out SPL, temp
                                 	; ----------------------------------------------------------
                                 
                                 
                                 	; ---- Configurações iniciais ----
                                 	; zera state_count
00002b 2700                      	clr state_count
                                 
                                 	; Define o clock como 16MHz
                                 	#define CLOCK 16.0e6
                                 	; Define um delay de 500ms
                                 	.equ delay = 500
                                 	; Fixa o prescale em 1024
                                 	.equ prescale = 0b0100
                                 	; Valor do prescale fixado
                                 	.equ prescale_div = 256
                                 	; Expressão que calcula o TOP
                                 	.equ TOP = int(((CLOCK * delay)/(prescale_div * 1000)) - 1)
                                 
                                 	; Define o baundrate em 9600 ideal para uma comunicação moderada
                                 	.equ baundrate = 9600
                                 	; Valor do UBRR
                                 	.equ UBRRvalue = int((CLOCK/(16 * baundrate)) - 1)
                                 
                                 	; Pra configurar o timer no modo ctc (contar tanto cansa)
                                 	.equ WGM = 0b0100
                                 	; ----------------------------------------------------------
                                 
                                 
                                 	; ---- Configura o serial ----
                                 	; configurando o Baund rate register
00002c e030                      	ldi temp, high(UBRRvalue)
00002d 9330 00c5                 	sts UBRR0H, temp
00002f e637                      	ldi temp, low(UBRRvalue)
000030 9330 00c4                 	sts UBRR0L, temp
                                 
                                 	; Configurando o USART control and status registrer C
                                 	; UMSEL01 E UMSEL01 = 0 0 ---> Modo assincrono
                                 	; UPM01 E UPM00 = 0 0 ----> Paridade desativada
                                 	; USBS0 = 0 ----> 1 Bit de parada
                                 	; UCSZ02, UCSZ01 E UCSZ00 = 0 1 1 ----> 8 bits por transimissão, ideal para transmitir caracteres
000032 e036                      	ldi temp, (0b11 << UCSZ00)
000033 9330 00c2                 	sts UCSR0C, temp
                                 
                                 	; Habilidando a transmissão dos sinais extraterrestres
000035 e038                      	ldi temp, (1 << TXEN0)
000036 9330 00c1                 	sts UCSR0B, temp
                                 
000038 d077                      	rcall charge_serial
                                 	; ----------------------------------------------------------
                                 
                                 
                                 	; ---- Configura porta como saída ----
                                 	; Configura como saída de 0 - 5 para a porta B
000039 e33f                      	ldi temp, $3F
00003a b934                      	out DDRB, temp
                                 
                                 	; Configura como saída de 0 - 5 para a porta C
00003b e33f                      	ldi temp, $3F
00003c b937                      	out DDRC, temp
                                 
                                 	; Configura como saída os bits 0, 2, 3, 4 , 5, 6 e 7 para a porta D
00003d ef3d                      	ldi temp, $FD
00003e b93a                      	out DDRD, temp
                                 	; ----------------------------------------------------------
                                 
                                 
                                 	; ---- Carregamento inicial da entrada ----
00003f d04f                      	rcall charge_leds
                                 	; ----------------------------------------------------------
                                 
                                 
                                 	; ---- Carregamento inicial da qtd de vezes que vai rodar a miséria ----
000040 d068                      	rcall charge_runtimes
                                 	; ----------------------------------------------------------
                                 
                                 
                                 	; ---- Configura inicialmente o timer ----
                                 	
                                 	; Carrega o valor de top no registrador OCR1A
000041 e73a                      	ldi temp, high(TOP)
000042 9330 0089                 	sts OCR1AH, temp
000044 e131                      	ldi temp, low(TOP)
000045 9330 0088                 	sts OCR1AL, temp
                                 
                                 	;Habilita as interrupções do timer
                                 	;Carrega o valor do registrador de controle do timer, evita carregar bagunça no TIMSK1
000047 9130 006f                 	lds temp, TIMSK1
                                 	;Seta OCIE1A para 1, habilitando as interrupções via timer
000049 6032                      	sbr temp, 1 << OCIE1A
                                 	;Carrega para o registrador de controle do timer
00004a 9330 006f                 	sts TIMSK1, temp
                                 
                                 	; Configurar o timer bolado pra contar (maldito só sabe contar até 4.12s)
                                 	; WGM&0b11 = 0b0100 & 0b0011 = 0b0000 
00004c e030                      	ldi temp, ((WGM&0b11) << WGM10)
00004d 9330 0080                 	sts TCCR1A, temp
                                 
                                 	;2 bits mais significativos de WGM e seleção de clock
                                 	; WGM >> 2 = 0b0100 >> 2 = 0b0001
                                 	; (WGM >> 2) << WGM12 = (0b0001 << 3) = 0b0001000
                                 	; (PRESCALE << CS10) = 0b101 << 0 = 0b101
                                 	; 0b0001000 | 0b101 = 0b0001101
00004f e03c                      	ldi temp, ((WGM>>2)<<WGM12)|(prescale << CS10)
000050 9330 0081                 	sts TCCR1B, temp
                                 	; ----------------------------------------------------------
                                 
                                 
                                 	; ---- Habilita globalmente as interrupções ----
000052 9478                      	sei
                                 	; ----------------------------------------------------------
                                 ; ============================================================
                                 	
                                 
                                 ; ============================================================
                                 ; Looping principal
                                 ; ============================================================
                                 loop:
000053 940c 0053                 	jmp loop
                                 
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; Tratamento da interrupção de mensagem
                                 ; ============================================================
                                 USART_UDRE_Interrupt:
000055 933f                      	push temp
000056 b73f                      	in temp, SREG
000057 933f                      	push temp
                                 
000058 93ff                      	push ZH
000059 93ef                      	push ZL
                                 
                                 	; Carrega o endereço da mensagem no registrador Z
00005a 2fe2                      	mov ZL, serial_low
00005b 2ff1                      	mov ZH, serial_high
                                 
                                 	; Carrega o byte que tá em Z e incrementa
00005c 9135                      	lpm temp, Z+
                                 
                                 	; Guarda o endereço do Z
00005d 2f2e                      	mov serial_low, ZL
00005e 2f1f                      	mov serial_high, ZH
                                 
                                 	; tst verifica se o valor de temp é 0, se for ele levanta a flag de zero no SREG
00005f 2333                      	tst temp
                                 	; Desvia para desligar a baixaria
000060 f019                      	breq fim_serial
                                 
                                 	; Manda o caracter pra o UDR
000061 9330 00c6                 	sts UDR0, temp
                                 
                                 	; Desvia para a saída da função
000063 c005                      	rjmp saida_serial
                                 
                                 	; Desliga a interrupção da serial
                                 	fim_serial:
000064 9130 00c1                 		lds temp, UCSR0B
000066 7d3f                      		andi temp, ~(1 << UDRIE0)
000067 9330 00c1                 		sts UCSR0B, temp
                                 
                                 	; Saida
                                 	saida_serial:
000069 91ef                      		pop ZL
00006a 91ff                      		pop ZH
00006b 913f                      		pop temp
00006c bf3f                      		out SREG, temp
00006d 913f                      		pop temp
                                 
00006e 9518                      		reti
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; Tratamendo da interrupção de timer
                                 ; ============================================================
                                 OCI1A_Interrupt:
                                 	; conceitualmente salvando o sreg ('_')
00006f 933f                      	push temp
000070 b73f                      	in temp, SREG
000071 933f                      	push temp
                                 
000072 934f                      	push temp2
000073 93ef                      	push ZL
000074 93ff                      	push ZH
                                 
                                 	; Verifica se count_aux tá zerado pra passar pro próximo estado
000075 3050                      	cpi count_aux, 0
000076 f029                      	breq proximo_estado
                                 
                                 	; Decrementa o miserável
000077 955a                      	dec count_aux
                                 
                                 	; Verifica se tá no estado que o vermelho de pedestres pisca pra piscar ele
000078 3002                      	cpi state_count, 2
000079 f471                      	brne exit
                                 
                                 	; Seta 1 no bit 3 do PIND
                                 	; A malandragem é que se escrever 1 no PIND ele inverte o valor do bit
                                 	; Se estava 0 (LED apagado), vira 1 (LED aceso)
                                 	; Se estava 1 (LED aceso), vira 0 (LED apagado)
00007a 9a4f                      	sbi PIND, 7
                                 
00007b c00c                      	rjmp exit
                                 
                                 
                                 	proximo_estado:
                                 		; Passa pro próximo estado
00007c 9503                      		inc state_count
                                 
                                 		; Verifica se chegou ao último estado
00007d 300c                      		cpi state_count, state_limit
                                 		; Caso não pula pra carregar o próximo estado
00007e f008                      		brlo estado_valido
                                 
                                 		; Volta pro estado inicial
00007f 2700                      		clr state_count
                                 
                                 	
                                 	; Carrega o próximo estado
                                 	estado_valido:
                                 		; Carrega os leds
000080 d00e                      		rcall charge_leds
                                 
                                 		; Prepara a ablação do caba
000081 d02e                      		rcall charge_serial
                                 		
                                 		; Zera o contador do timer
000082 2733                      		clr temp
000083 9330 0085                 		sts TCNT1H, temp
000085 9330 0084                 		sts TCNT1L, temp
                                 
                                 		; Carregamento inicial da qtd de vezes que vai rodar a miséria
000087 d021                      		rcall charge_runtimes
                                 
                                 	; Saida
                                 	; Despusha o SREG
                                 	exit:
000088 91ff                      		pop ZH
000089 91ef                      		pop ZL
00008a 914f                      		pop temp2
00008b 913f                      		pop temp
00008c bf3f                      		out SREG, temp
00008d 913f                      		pop temp
                                 
00008e 9518                      	reti
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; Carrega o mapeamento dos leds
                                 ; ============================================================
                                 charge_leds:
                                 	; Configurando z com o mapeamento inicial
00008f e0f1                      	ldi ZH, high(mapeamento << 1)
000090 e8e2                      	ldi ZL, low(mapeamento << 1)
                                 
                                 	; Multiplica o state_count por 2
000091 2f30                      	mov temp, state_count
000092 0f33                      	lsl temp
                                 
                                 	; Incrementa para pegar o indice certo do mapeamento
000093 0fe3                      	add ZL, temp
000094 2733                      	clr temp
000095 1ff3                      	adc ZH, temp
                                 
                                 	; Carrega os leds do estado
000096 9135                      	lpm temp, Z+ ; Lê o menos significativo
000097 9144                      	lpm temp2, Z ; Lê o mais significativo
                                 
                                 	; Carrega 6 leds na porta B (De 0 - 5)
000098 933f                      	push temp
                                 	; Mascara pra pegar os 6 bits
000099 733f                      	andi temp, $3F
00009a b935                      	out PORTB, temp
00009b 913f                      	pop temp
                                 
                                 	; Gambiarra pra pegar os dois últimos bits que não foram para PORTB
                                 	; O lsl desloca os bits para << e joga o bit 7 no carry
                                 	; O rol desloca os bits de temp2 para << e joga o carry no bit 0
00009c 0f33                      	lsl temp
00009d 1f44                      	rol temp2
00009e 0f33                      	lsl temp
00009f 1f44                      	rol temp2
                                 
                                 	; Carrega mais 6 leds na porta C (De 0 - 5)
0000a0 2f34                      	mov temp, temp2
                                 	; Mascara pra pegar os 6 bits
0000a1 733f                      	andi temp, $3F
0000a2 b938                      	out PORTC, temp
                                 
                                 	; Troca os 4 primeiros bits com os últimos 4 bits
                                 	; Mascara pra pegar os 2 bits
0000a3 7c40                      	andi temp2, $C0
                                 	; Pega o que tá na porta D
0000a4 b13b                      	in temp, PORTD
                                 	; Zera só o que tiver nos bits que queremos
0000a5 733f                      	andi temp, $3F
                                 	; Junta com o que tem no temp 2
0000a6 2b34                      	or temp, temp2
                                 	; Escreve na porta D
0000a7 b93b                      	out PORTD, temp
                                 	; ----------------------------------------------------------
                                 
0000a8 9508                      	ret
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; Carrega a quantidade de vezes que cada interrupção vai rodar
                                 ; ============================================================
                                 charge_runtimes:
                                 	; Carregando o top inicial em Z
0000a9 e0f1                      	ldi ZH, high(qtd_runs << 1)
0000aa e9ea                      	ldi ZL, low(qtd_runs << 1)
                                 
                                 	; Funciona igual ao carregamento do próximo estado
0000ab 0fe0                      	add ZL, state_count
0000ac 2733                      	clr temp
0000ad 1ff3                      	adc ZH, temp
                                 
                                 	; Carrega o byte menos significativo do top
0000ae 9154                      	lpm count_aux, z
                                 
0000af 9508                      	ret
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; Prepara para mandar a mensagem
                                 ; ============================================================
                                 charge_serial:
0000b0 e0f5                      	ldi ZH, high(serial_mensage << 1)
0000b1 e0e6                      	ldi ZL, low(serial_mensage << 1)
                                 	
                                 	; Multiplica por 2
0000b2 2f30                      	mov temp, state_count
0000b3 0f33                      	lsl temp
                                 
                                 	; Incrementa certo
0000b4 0fe3                      	add ZL, temp
0000b5 2733                      	clr temp
0000b6 1ff3                      	adc ZH, temp
                                 
                                 	; Carrega da memoria
0000b7 9125                      	lpm serial_low, Z+
0000b8 9114                      	lpm serial_high, Z
                                 
                                 	; Multiplica por 2, isso será usado como endereço para a mensagem enviada
0000b9 0f22                      	lsl serial_low
0000ba 1f11                      	rol serial_high
                                 
                                 	; Liga a interrupção de UDR0
                                 	; Desta forma se UDR0 estiver vazio ele vai interromper pra enviar a mensagem -_-'
0000bb 9130 00c1                 	lds temp, UCSR0B
0000bd 6230                      	ori temp, (1 << UDRIE0)
0000be 9330 00c1                 	sts UCSR0b, temp
                                 
0000c0 9508                      	ret
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; Mapeamento dos leds marotos
                                 
                                 ; StoN
                                 ; Semaforo 1: verde (bit 0), amarelo (bit 1), vermelho (bit 2)
                                 ; StoW
                                 ; Semaforo 2: verde (bit 3), amarelo (bit 4), vermelho (bit 5)
                                 ; WtoSaN
                                 ; Semaforo 3: verde (bit 6), amarelo (bit 7), vermelho (bit 8)
                                 ; NtoWaS
                                 ; Semaforo 4: verde (bit 9), amarelo (bit 10), vermelho (bit 11)
                                 ; Nc+Sc
                                 ; Semaforo 5: verde (bit 12), vermelho(bit 13)
                                 ; ============================================================
                                 ; Semaforo 1
                                 .equ S1_G = (1 << 0)
                                 .equ S1_Y = (1 << 1)
                                 .equ S1_R = (1 << 2)
                                 
                                 ; Semaforo 2
                                 .equ S2_G = (1 << 3)
                                 .equ S2_Y = (1 << 4)
                                 .equ S2_R = (1 << 5)
                                 
                                 ; Semaforo 3
                                 .equ S3_G = (1 << 6)
                                 .equ S3_Y = (1 << 7)
                                 .equ S3_R = (1 << 8)
                                 
                                 
                                 ; Semaforo 4
                                 .equ S4_G = (1 << 9)
                                 .equ S4_Y = (1 << 10)
                                 .equ S4_R = (1 << 11)
                                 
                                 ; Semaforo 5
                                 .equ S5_G = (1 << 12)
                                 .equ S5_R = (1 << 13)
                                 
                                 
                                 mapeamento:
                                 	; Estado 1
0000c1 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 2
0000c2 1924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_G 
                                 	; Estado 3
                                 	; O de pedestre pisca
0000c3 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 4
0000c4 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 5
0000c5 2909                      	.dw S1_G|S2_G|S3_R|S4_R|S5_R
                                 	; Estado 6
0000c6 2911                      	.dw S1_G|S2_Y|S3_R|S4_R|S5_R
                                 	; Estado 7
0000c7 2921                      	.dw S1_G|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 8
0000c8 2321                      	.dw S1_G|S2_R|S3_R|S4_G|S5_R
                                 	; Estado 9
0000c9 2522                      	.dw S1_Y|S2_R|S3_R|S4_Y|S5_R
                                 	; Estado 10
0000ca 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 11
0000cb 2864                      	.dw S1_R|S2_R|S3_G|S4_R|S5_R
                                 	; Estado 12
0000cc 28a4                      	.dw S1_R|S2_R|S3_Y|S4_R|S5_R
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; Mapeamento da quantidade de vezes que vai acontecer as interrupções
                                 ; ============================================================
                                 qtd_runs:
                                 ; Definindo os limites de execuções, algumas interrupções terão que rodar mais vezes
                                 ; É o caso do estado 2 em que o timer precisa bater 12s mas o maldito timer só sabe contar até 4.2
                                 ; Tive que botar pra repetir no 3 só pra ele ficar piscando D:
                                 ; 1s -> vai rodar 2 vezes de 0.5s
                                 ; 12s -> vai rodar 24 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
                                 ; 2s -> vai rodar 4 vezes de 0.5s
                                 ; 22s -> vai rodar 44 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
                                 ; 1s -> vai rodar 2 vezes de 0.5s
                                 ; 60s -> vai rodar 120 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
                                 ; 25s -> vai rodar 60 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
0000cd 1701
0000ce 0307
0000cf 072b
0000d0 7701
0000d1 0107
0000d2 0731                      .db 1, 23, 7, 3, 43, 7, 1, 119, 7, 1, 49, 7
                                 ; ============================================================
                                 
                                 
                                 ; ============================================================
                                 ; mensagens para mandar
                                 ; ============================================================
                                 ; Estado 1
                                 msg1:
0000d3 3153
0000d4 203a
0000d5 6556
0000d6 6d72
0000d7 6c65
0000d8 6f68
0000d9 0a0d
0000da 3253
0000db 203a
0000dc 6556
0000dd 6d72
0000de 6c65
0000df 6f68
0000e0 0a0d
0000e1 3353
0000e2 203a
0000e3 6556
0000e4 6d72
0000e5 6c65
0000e6 6f68
0000e7 0a0d
0000e8 3453
0000e9 203a
0000ea 6556
0000eb 6d72
0000ec 6c65
0000ed 6f68
0000ee 0a0d
0000ef 3553
0000f0 203a
0000f1 6556
0000f2 6d72
0000f3 6c65
0000f4 6f68
0000f5 0a0d
0000f6 0a0d
0000f7 0000                          .db "S1: Vermelho", 13, 10, "S2: Vermelho", 13, 10, "S3: Vermelho", 13, 10, "S4: Vermelho", 13, 10, "S5: Vermelho", 13, 10, 13, 10, 0, 0
                                 
                                 ; Estado 2
                                 msg2:
0000f8 3153
0000f9 203a
0000fa 6556
0000fb 6d72
0000fc 6c65
