                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; semaforoforo.asm
                                 ;
                                 ; Created: 07/10/2026 11:25:39
                                 ; Authors :
                                 
                                 
                                 ; Determina um segmento de código para a FLASH
                                 .cseg
                                 
                                 ; ==============================================
                                 ; Registradores
                                 ; ==============================================
                                 .def state_count = r16 ; Contagem dos estados
                                 .def serial_high = r17 ; Armazena a parte alta do endereço da mensagem do estado
                                 .def serial_low = r18 ; Armazena a parte baixa do endereço da mensagem do estado
                                 .def temp = r19 ; Registrador que auxilia durante o programa
                                 .def temp2 = r20 ; Registrador que auxilia durante o programa
                                 .def count_aux = r21 ; Conta quantas interrupções foram feitas pelo timer 1
                                 .def dezena = r22 ; Armazena a dezena do display
                                 .def unidade = r23 ; Armazena a unidade do display
                                 .def display_select = r24 ; Alterna o display, entre dezena e unidade
                                 .def s1count = r25 ; Conta 2 interrupções de 0.5s
                                 ; ==============================================
                                 
                                 
                                 ; ==============================================
                                 ; Constantes
                                 ; ==============================================
                                 .set state_limit = 12 ; Limite de estados
                                 .set s1_limit = 2 ; Limite de interrupções para 1s
                                 
                                 .set d46 = 4 ; Dezena do primeiro ciclo
                                 .set u46 = 6 ; Unidade do primeiro ciclo
                                 .set d64 = 6 ; Dezena do estado de "aberto"
                                 .set u64 = 4 ; Unidade do estado de "aberto"
                                 .set d75 = 7 ; Dezena do estado de fechado
                                 .set u75 = 5 ; Unidade do estado de fechado
                                 
                                 #define CLOCK 16.0e6 ; Define o clock como 16MHz
                                 
                                 ; #==== Timer 0 ====#
                                 ; Será usado para o display
                                 ; Este timer só conta até 256 (tem 1 byte só)
                                 .equ delay0 = 2 ; Define um delay de 5ms
                                 .equ prescale0 = 0b101 ; Fixa o prescale do timer 2 em 1024
                                 .equ prescale_div0 = 1024 ; Valor do prescale fixado
                                 .equ TOP0 = int(((CLOCK * delay0)/(prescale_div0 * 1000)) - 1) ; Expressão que calcula o TOP0
                                 .equ WGM0 = 0b10 ; Para configurar o timer 0 no modo ctc
                                 ; #===================
                                 
                                 ; #==== Timer 1 ====#
                                 ; Será usado para interrupção do estado
                                 .equ delay = 500 ; Define um delay de 500ms
                                 .equ prescale = 0b0100 ; Fixa o prescale do timer 1 em 256
                                 .equ prescale_div = 256 ; Valor do prescale fixado
                                 .equ TOP = int(((CLOCK * delay)/(prescale_div * 1000)) - 1) ; Expressão que calcula o TOP
                                 .equ WGM = 0b0100 ; Pra configurar o timer 1 no modo ctc
                                 ; #===================
                                  
                                  ; #==== USART ====#
                                 .equ baundrate = 9600 ; Define o baundrate em 9600 ideal para uma comunicação moderada
                                 .equ UBRRvalue = int((CLOCK/(16 * baundrate)) - 1) ; Valor do UBRR
                                 ; #===================
                                 ; ==============================================
                                 
                                 
                                 
                                 ; ==============================================
                                 ; Inicia o tudo
                                 ; ==============================================
                                 .org 0 ; Manda PC para o endereço 0
000000 940c 0027                 jmp reset ; Pula para o inicializador do maldito programa
                                 ; ==============================================
                                 
                                 
                                 
                                 ; ==============================================
                                 ; Tratamento da interrupção do timer 1
                                 ; ==============================================
                                 .org OC1Aaddr ; Move o PC para o endereço da interrupção do timer 1
000016 c087                      rjmp OCI1A_Interrupt ; Desvia para a subrotina de tratamento do timer 1
                                 ; ==============================================
                                 
                                 
                                 ; ==============================================
                                 ; Tratamento da interrupção do timer 1
                                 ; ==============================================
                                 .org OC0Aaddr ; Move o PC para o endereço da interrupção do timer 0
00001c c069                      rjmp TIMER0_Interrupt ; Desvia para a subrotina de tratamento do timer 0
                                 ; ==============================================
                                 
                                 
                                 
                                 ; ==============================================
                                 ; Tratamento da interrupção do serial
                                 ; ==============================================
                                 .org UDREaddr ; Move o PC para o endereço da interrupção de envio
000026 c045                      rjmp USART_UDRE_Interrupt ; Desvia para a subrotina de tratamento de envio da serial
                                 ; ==============================================
                                 
                                 
                                 
                                 ; ============================================================
                                 ; Reset
                                 ; ============================================================
                                 reset:
                                 	; ---- Inicia a pilha para podermos utilizar subrotinas ----
000027 e038                      	ldi temp, high(RAMEND)
000028 bf3e                      	out SPH, temp
000029 ef3f                      	ldi temp, low(RAMEND)
00002a bf3d                      	out SPL, temp
                                 	; ----------------------------------------------------------
                                 
                                 	
00002b 2700                      	clr state_count ; Zera o contador de estados
00002c 2788                      	clr display_select ; Zera o seletor do display
00002d 2799                      	clr s1count ; Zera o contador de interrupções para contar 1s
                                 
00002e d012                      	rcall init_uart ; Inicializa a transmissão
00002f d00a                      	rcall init_ports ; Inicializa as portas dos leds
                                 
                                 
000030 d0ad                      	rcall charge_leds ; Carrega o estado inicial dos leds
000031 d0cd                      	rcall charge_serial ; Carrega a mensagem inicial
000032 d0c5                      	rcall charge_runtimes ; Carrega a quantidade de vezes que o estado inicial vai rodar
                                 
000033 e064                      	ldi dezena, d46 ; Carrega 7 do display no registrador da dezena
000034 e076                      	ldi unidade, u46 ; Carrega 6 do display no registrador da unidade
                                 
000035 d024                      	rcall init_timer ; Inicia o timer 1
000036 d017                      	rcall init_timer0 ; Inicia o timer 0
                                 
000037 9478                      	sei ; Habilita as interrupções globais
                                 ; ============================================================
                                 	
                                 
                                 
                                 ; ============================================================
                                 ; Looping principal
                                 ; ============================================================
                                 loop:
000038 940c 0038                 	jmp loop
                                 
                                 ; ============================================================
                                 
                                 
                                 
                                 ; ============================================================
                                 ; Iniciando os periféricos
                                 ; ============================================================
                                 ; #==== Inicializa as portas de saída ====#
                                 init_ports:
                                 	; Configura como saída de 0 - 5 para a porta B
00003a e33f                      	ldi temp, $3F
00003b b934                      	out DDRB, temp
                                 
                                 	; Configura como saída de 0 - 5 para a porta C
00003c e33f                      	ldi temp, $3F
00003d b937                      	out DDRC, temp
                                 
                                 	; Configura como saída os bits 0, 2, 3, 4 , 5, 6 e 7 para a porta D
00003e ef3d                      	ldi temp, $FD
00003f b93a                      	out DDRD, temp
                                 	
000040 9508                      	ret
                                 ; #=====================================#
                                 
                                 
                                 ; #==== Inicializa o registrador do serial ====#
                                 init_uart:
                                 	; configurando o Baund rate register
000041 e030                      	ldi temp, high(UBRRvalue)
000042 9330 00c5                 	sts UBRR0H, temp
000044 e637                      	ldi temp, low(UBRRvalue)
000045 9330 00c4                 	sts UBRR0L, temp
                                 
                                 	; Configurando o USART control and status registrer C
                                 	; UMSEL01 E UMSEL01 = 0 0 ---> Modo assincrono
                                 	; UPM01 E UPM00 = 0 0 ----> Paridade desativada
                                 	; USBS0 = 0 ----> 1 Bit de parada
                                 	; UCSZ02, UCSZ01 E UCSZ00 = 0 1 1 ----> 8 bits por transimissão, ideal para transmitir caracteres
000047 e036                      	ldi temp, (0b11 << UCSZ00)
000048 9330 00c2                 	sts UCSR0C, temp
                                 
                                 	; Habilidando a transmissão
00004a e038                      	ldi temp, (1 << TXEN0)
00004b 9330 00c1                 	sts UCSR0B, temp
                                 
00004d 9508                      	ret
                                 ; #=====================================#
                                 
                                 
                                 ; #==== Inicia o timer 0 ====#
                                 init_timer0:
                                 	; Carrega o TOP do timer 0
00004e e13e                      	ldi temp, TOP0
00004f bd37                      	out OCR0A, temp
                                 
                                 	; Habilita a interrpução pelo timer 0
000050 9130 006e                 	lds temp, TIMSK0
000052 6032                      	ori temp, (1 << OCIE0A)
000053 9330 006e                 	sts TIMSK0, temp
                                 
                                 	; Coloca o timer 0 no modo CTC
000055 e032                      	ldi temp, (WGM0 << WGM00)
000056 bd34                      	out TCCR0A, temp
                                 
                                 	; Inicia o timer 0 com o prescale 1024
000057 e035                      	ldi temp, (prescale0 << CS00)
000058 bd35                      	out TCCR0B, temp
                                 
000059 9508                      	ret
                                 ; #=====================================#
                                 
                                 ; #==== Inicia o timer 1 ====#
                                 init_timer:
                                 	; Carrega o valor de top no registrador OCR1A
00005a e73a                      	ldi temp, high(TOP)
00005b 9330 0089                 	sts OCR1AH, temp
00005d e131                      	ldi temp, low(TOP)
00005e 9330 0088                 	sts OCR1AL, temp
                                 
                                 	;Habilita as interrupções do timer
                                 	;Carrega o valor do registrador de controle do timer, evita carregar bagunça no TIMSK1
000060 9130 006f                 	lds temp, TIMSK1
                                 	;Seta OCIE1A para 1, habilitando as interrupções via timer
000062 6032                      	sbr temp, 1 << OCIE1A
                                 	;Carrega para o registrador de controle do timer
000063 9330 006f                 	sts TIMSK1, temp
                                 
                                 	; Configurar o timer bolado pra contar (maldito só sabe contar até 0.5s	)
                                 	; WGM&0b11 = 0b0100 & 0b0011 = 0b0000 
000065 e030                      	ldi temp, ((WGM&0b11) << WGM10)
000066 9330 0080                 	sts TCCR1A, temp
                                 
                                 	;2 bits mais significativos de WGM e seleção de clock
                                 	; WGM >> 2 = 0b0100 >> 2 = 0b0001
                                 	; (WGM >> 2) << WGM12 = (0b0001 << 3) = 0b0001000
                                 	; (PRESCALE << CS10) = 0b101 << 0 = 0b101
                                 	; 0b0001000 | 0b101 = 0b0001101
000068 e03c                      	ldi temp, ((WGM>>2)<<WGM12)|(prescale << CS10)
000069 9330 0081                 	sts TCCR1B, temp
                                 
00006b 9508                      	ret
                                 ; #=====================================#
                                 ; ============================================================
                                 
                                 
                                 
                                 ; ============================================================
                                 ; Tratamento das interrupções
                                 ; ============================================================
                                 ; #==== Interrupção de transmissão do serial ====#
                                 USART_UDRE_Interrupt:
                                 	; Armazena inicialmente alguns registradores por precaução
00006c 933f                      	push temp
00006d b73f                      	in temp, SREG
00006e 933f                      	push temp
00006f 93ff                      	push ZH
000070 93ef                      	push ZL
                                 
                                 
                                 	; Carrega o endereço, no registrador Z, da mensagem que será enviada
000071 2fe2                      	mov ZL, serial_low
000072 2ff1                      	mov ZH, serial_high
                                 
                                 
                                 	; Carrega o caracter na posição de Z e atualiza para o próximo endereço
                                 	; Estamos enviando caracter por caracter
000073 9135                      	lpm temp, Z+
                                 
                                 
                                 	; Guarda o endereço atualizado para continuar o envio da mensagem
000074 2f2e                      	mov serial_low, ZL
000075 2f1f                      	mov serial_high, ZH
                                 
                                 
                                 	; tst verifica se o valor de temp é 0, se for ele levanta a flag de zero no SREG
000076 2333                      	tst temp
                                 	; Desvia, caso tenha recebido 0, para encerrar o envio da mensagem
000077 f019                      	breq fim_serial
                                 
                                 	; Manda o caracter pra o UDR enviando ele pro serial
000078 9330 00c6                 	sts UDR0, temp
                                 
                                 	; Desvia para a saída da função
00007a c005                      	rjmp saida_serial
                                 
                                 	; Encerra o envio desligando a interrupção
                                 	fim_serial:
00007b 9130 00c1                 		lds temp, UCSR0B
00007d 7d3f                      		andi temp, ~(1 << UDRIE0)
00007e 9330 00c1                 		sts UCSR0B, temp
                                 
                                 	; Sai da interrupção
                                 	saida_serial:
000080 91ef                      		pop ZL
000081 91ff                      		pop ZH
000082 913f                      		pop temp
000083 bf3f                      		out SREG, temp
000084 913f                      		pop temp
                                 
000085 9518                      		reti
                                 ; #=====================================#
                                 
                                 
                                 ; #==== Interrupção do timer 0 ====#
                                 TIMER0_Interrupt:
000086 933f                      	push temp
000087 b73f                      	in temp, SREG
000088 933f                      	push temp
000089 934f                      	push temp2
                                 
                                 	; Faz um xor zerando ou setando 1 na seleção do display
00008a e031                      	ldi temp, 1
00008b 2783                      	eor display_select, temp
00008c b13b                      	in temp, PORTD
                                 
                                 
00008d 2388                      	tst display_select
00008e f029                      	breq mostra_unidade
                                 
                                 	mostra_dezena:
00008f 6031                      		ori temp, (1 << 0)
000090 2f46                      		mov temp2, dezena
                                 
000091 d07e                      		rcall charge_display
000092 940c 0099                 		jmp saida_timer
                                 		 
                                 	mostra_unidade:
000094 7f3e                      		andi temp, ~(1 << 0)
000095 2f47                      		mov temp2, unidade
                                 
000096 d079                      		rcall charge_display
000097 940c 0099                 		jmp saida_timer
                                 
                                 	; Saída
                                 	saida_timer:
000099 914f                      		pop temp2
00009a 913f                      		pop temp
00009b bf3f                      		out SREG, temp
00009c 913f                      		pop temp
                                 
00009d 9518                      		reti
                                 ; ; #=====================================#
                                 
                                 
                                 ; #==== Interrupção do timer 1 ====#
                                 OCI1A_Interrupt:
                                 	; Armazena inicialmente alguns registradores por precaução
00009e 933f                      	push temp
00009f b73f                      	in temp, SREG
0000a0 933f                      	push temp
0000a1 934f                      	push temp2
0000a2 93ef                      	push ZL
0000a3 93ff                      	push ZH
                                 
                                 	; incrementa
0000a4 9593                      	inc s1count
                                 
                                 	; Verifica se contou 1s
0000a5 3092                      	cpi s1count, s1_limit
0000a6 f469                      	brne continua
                                 
                                 	; Testa se a unidade zerou
0000a7 2377                      	tst unidade
0000a8 f021                      	breq decrementa_dezena
                                 
                                 	decrementa_unidade:
0000a9 957a                      		dec unidade
0000aa 2799                      		clr s1count
0000ab 940c 00b4                 		jmp continua
                                 
                                 	decrementa_dezena:
0000ad 2366                      		tst dezena
0000ae f029                      		breq continua
                                 		
0000af 956a                      		dec dezena
0000b0 e079                      		ldi unidade, 9
0000b1 2799                      		clr s1count
0000b2 940c 00b4                 		jmp continua
                                 
                                 	continua:
                                 		; Verifica se o contador auxiliar é 0, caso seja, pula para o próximo estado
0000b4 3050                      		cpi count_aux, 0
0000b5 f029                      		breq proximo_estado
                                 
                                 		; Caso o contador não seja 0 significa que ainda não mudou de estado e decrementa ele
0000b6 955a                      		dec count_aux
                                 
                                 		; Verifica se está no estado (Fechando para pedestres), caso não esteja ele desvia pra saída
0000b7 3002                      		cpi state_count, 2
0000b8 f4f1                      		brne exit
                                 
                                 		; Caso esteja no estado 2 faz o led vermelho piscar
                                 		; Seta 1 no bit 7 do PIND
                                 		; A ideia é que se escrever 1 no PIND ele inverte o valor do bit
                                 		; Se estava 0 (LED apagado), vira 1 (LED aceso)
                                 		; Se estava 1 (LED aceso), vira 0 (LED apagado)
0000b9 9a4f                      		sbi PIND, 7
                                 
0000ba c01c                      		rjmp exit
                                 
                                 
                                 	; Passa para o próximo estado
                                 	proximo_estado:
                                 		; Incrementa para passar pro próximo estado
0000bb 9503                      		inc state_count
                                 
                                 		; Verifica se chegou ao último estado, caso não seja ele desvia para carregar o próximo estado
0000bc 300c                      		cpi state_count, state_limit
0000bd f008                      		brlo estado_valido
                                 
                                 		; Caso seja o último estado ele zera o estate_count fazendo voltar para o primeiro estado
0000be 2700                      		clr state_count
                                 
                                 	
                                 	; Carrega o próximo estado
                                 	estado_valido:
                                 		; Carrega o 64
0000bf 3007                      		cpi state_count, 7
0000c0 f021                      		breq carrega_64
                                 
                                 		; Carrega o 76
0000c1 3009                      		cpi state_count, 9
0000c2 f039                      		breq carrega_75
                                 
0000c3 940c 00cf                 		jmp continua2
                                 
                                 		carrega_64:
0000c5 e066                      			ldi dezena, d64
0000c6 e074                      			ldi unidade, u64
0000c7 2799                      			clr s1count
0000c8 940c 00cf                 			jmp continua2
                                 
                                 		carrega_75:
0000ca e067                      			ldi dezena, d75
0000cb e075                      			ldi unidade, u75
0000cc 2799                      			clr s1count
0000cd 940c 00cf                 			jmp continua2
                                 
                                 		continua2:
                                 			; Carrega o novo estado dos leds
0000cf d00e                      			rcall charge_leds
                                 
                                 			; Prepara para tramissão da mensagem do novo estado
0000d0 d02e                      			rcall charge_serial
                                 		
                                 			; Zera o contador do timer
0000d1 2733                      			clr temp
0000d2 9330 0085                 			sts TCNT1H, temp
0000d4 9330 0084                 			sts TCNT1L, temp
                                 
                                 			; Carrega a nova quantidade de vezes que ele vai interromper
0000d6 d021                      			rcall charge_runtimes
                                 
                                 	; Saida
                                 	exit:
0000d7 91ff                      		pop ZH
0000d8 91ef                      		pop ZL
0000d9 914f                      		pop temp2
0000da 913f                      		pop temp
0000db bf3f                      		out SREG, temp
0000dc 913f                      		pop temp
                                 
0000dd 9518                      	reti
                                 ; #=====================================#
                                 ; ============================================================
                                 
                                 
                                 
                                 ; ============================================================
                                 ; Carregamento
                                 ; ============================================================
                                 ; #==== Carrega o estado dos leds ====#
                                 charge_leds:
                                 	; Configurando Z com o endereço do mapeamento dos leds
0000de e0f2                      	ldi ZH, high(mapeamento << 1)
0000df e2ec                      	ldi ZL, low(mapeamento << 1)
                                 
                                 	; Multiplica o state_count por 2 para podermos fazer um incrementador dinâmico
                                 	; Desta forma vai funcionar como um vetor em que cada estado é um índice e tem sua configuração específica
                                 	; Isso é necessário pois no mapeamento armazenamos 2 bytes(1 palavra)
0000e0 2f30                      	mov temp, state_count
0000e1 0f33                      	lsl temp
                                 
                                 	; Incrementa para pegar o indice certo do mapeamento
0000e2 0fe3                      	add ZL, temp
0000e3 2733                      	clr temp
0000e4 1ff3                      	adc ZH, temp
                                 
                                 	; Carrega os leds do estado
0000e5 9135                      	lpm temp, Z+ ; Lê o menos significativo
0000e6 9144                      	lpm temp2, Z ; Lê o mais significativo
                                 
                                 	; Carrega 6 leds na porta B (De 0 - 5)
                                 	; Armazena o temp para não perdermos com a próxima operação
0000e7 933f                      	push temp
                                 
                                 	; Mascara pra pegar os 6 bits
                                 	; 3F = 00111111
                                 	; O andi vai zerar apenas os dois últimos bits
0000e8 733f                      	andi temp, $3F
                                 	; Joga os 6 bits na porta B
0000e9 b935                      	out PORTB, temp
                                 	; Restaura temp para pegarmos os 2 bits que faltaram
0000ea 913f                      	pop temp
                                 
                                 	; Pega os dois últimos bits que não foram para PORTB
                                 	; A ideia é fazer algo como:
                                 	; temp = 11000000 << 1 = 10000000 e C = 1
                                 	; temp2 = 00000000 << 1 = 00000001 e C = 0
                                 	; temp = 10000000 << 1 = 00000000 e C = 1
                                 	; temp2 = 00000001 << 1 = 00000011 e C = 0
0000eb 0f33                      	lsl temp ; Desloca todos os bits para << e joga o mais significativo no carry
0000ec 1f44                      	rol temp2 ; Desloca todos os bits para << e pega o bit do carry e joga no menos significativo
0000ed 0f33                      	lsl temp ; Desloca todos os bits para << e joga o mais significativo no carry
0000ee 1f44                      	rol temp2 ; Desloca todos os bits para << e pega o bit do carry e joga no menos significativo
                                 
                                 	; Carrega mais 6 leds na porta C (De 0 - 5)
                                 	; Copia o que está no temp2 para o temp. Isso ajuda pois depois precisaremos pegar os 2 últimos bits de temp2
0000ef 2f34                      	mov temp, temp2
                                 	; Mascara pra pegar os 6 bits
                                 	; 3F = 00111111
0000f0 733f                      	andi temp, $3F
                                 	; Joga os 6 bits na porta C
0000f1 b938                      	out PORTC, temp
                                 
                                 
                                 	; Mascara pra pegar os 2 bits
                                 	; C0 = 110000
                                 	; O andi vai prezervar apenas os dois primeiros bits
0000f2 7c40                      	andi temp2, $C0
                                 
                                 	; Pega o que tá na porta D
                                 	; Como a porta D também vai estar com o serial, displays e controle deles precisamos evitar sobreescrever
0000f3 b13b                      	in temp, PORTD
                                 
                                 	; Zera só o que tiver nos bits que queremos
                                 	; 3F = 00111111
0000f4 733f                      	andi temp, $3F
                                 
                                 	; Junta o que tem na porta D com o estado atual dos 2 últimos leds
0000f5 2b34                      	or temp, temp2
                                 	; Joga tudo na porta D
0000f6 b93b                      	out PORTD, temp
                                 
0000f7 9508                      	ret
                                 ; #=====================================#
                                 
                                 
                                 ; #==== Carrega a quantidade de vezes que cada interrupção vai rodar ====#
                                 charge_runtimes:
                                 	; Configurando Z com o endereço do mapeamento da quantidade de vezes que vai rodar em cada estado 
0000f8 e0f2                      	ldi ZH, high(qtd_runs << 1)
0000f9 e4e4                      	ldi ZL, low(qtd_runs << 1)
                                 
                                 	; Soma o state_count ao endereço de Z para jogar na posição certa
                                 	; Aqui não multiplicamos por 2 pois qtd_runs armazena de byte em byte, logo, cada indice do array tem 1 byte
0000fa 0fe0                      	add ZL, state_count
0000fb 2733                      	clr temp
0000fc 1ff3                      	adc ZH, temp
                                 
                                 	; Carrega o a quantidade de vezes que o estado vai rodar em count_aux
0000fd 9154                      	lpm count_aux, z
                                 
0000fe 9508                      	ret
                                 ; #=====================================#
                                 
                                 
                                 ; #==== Prepara para mandar a mensagem ====#
                                 charge_serial:
                                 	; Configurando Z com o endereço das mensagens do serial
0000ff e0f5                      	ldi ZH, high(serial_mensage << 1)
000100 ebe0                      	ldi ZL, low(serial_mensage << 1)
                                 	
                                 	; Multiplica o state_count por 2 para podermos fazer um incrementador dinâmico
                                 	; Desta forma vai funcionar como um vetor em que cada estado é um índice e tem sua configuração específica
                                 	; Isso é necessário pois no mapeamento armazenamos 2 bytes(1 palavra)
000101 2f30                      	mov temp, state_count
000102 0f33                      	lsl temp
                                 
                                 	; Incrementa para pegar o indice certo do mapeamento
000103 0fe3                      	add ZL, temp
000104 2733                      	clr temp
000105 1ff3                      	adc ZH, temp
                                 
                                 	; Carrega qual mensagem vamos mandar
                                 	; Aqui ele meio que carrega como "string", ou seja, se for msg1 ele vai carregar "msg1"
000106 9125                      	lpm serial_low, Z+ ; Pega o byte menos significativo
000107 9114                      	lpm serial_high, Z ; Pega o byte mais significativo
                                 
                                 	; Para transformar a mensagem em um endereço e carregar no registrador Z depois precisamos multiplicar por 2
                                 	; É igual a essa lógica, em que i representa o estado:
                                 	; ldi ZH, high(msgi << 1)
                                 	; ldi ZL, low(msgi << 1)
                                 	; após isso teremos o msg1 como um endereço pronto pra ser usado
000108 0f22                      	lsl serial_low
000109 1f11                      	rol serial_high
                                 
                                 	; Liga a interrupção de UDR0
                                 	; Desta forma se UDR0 estiver vazio ele vai interromper pra enviar a mensagem -_-'
00010a 9130 00c1                 	lds temp, UCSR0B
00010c 6230                      	ori temp, (1 << UDRIE0)
00010d 9330 00c1                 	sts UCSR0b, temp
                                 
00010f 9508                      	ret
                                 ; #=====================================#
                                 
                                 
                                 ; #==== Carrega o display ====#
                                 charge_display:
000110 7c33                      	andi temp, 0b11000011
                                 
000111 0f44                      	lsl temp2
000112 0f44                      	lsl temp2
                                 
000113 2b34                      	or temp, temp2
                                 
000114 b93b                      	out PORTD, temp
                                 
000115 9508                      	ret
                                 ; #=====================================#
                                 ; ============================================================
                                 
                                 
                                 
                                 ; ============================================================
                                 ; Dados da FLASH
                                 ; ============================================================
                                 ;#==== Mapeamento dos leds ====#
                                 ; StoN
                                 ; Semaforo 1: verde (bit 0), amarelo (bit 1), vermelho (bit 2)
                                 ; StoW
                                 ; Semaforo 2: verde (bit 3), amarelo (bit 4), vermelho (bit 5)
                                 ; WtoSaN
                                 ; Semaforo 3: verde (bit 6), amarelo (bit 7), vermelho (bit 8)
                                 ; NtoWaS
                                 ; Semaforo 4: verde (bit 9), amarelo (bit 10), vermelho (bit 11)
                                 ; Nc+Sc
                                 ; Semaforo 5: verde (bit 12), vermelho(bit 13)
                                 
                                 ; Semaforo 1
                                 .equ S1_G = (1 << 0)
                                 .equ S1_Y = (1 << 1)
                                 .equ S1_R = (1 << 2)
                                 ; Semaforo 2
                                 .equ S2_G = (1 << 3)
                                 .equ S2_Y = (1 << 4)
                                 .equ S2_R = (1 << 5)
                                 ; Semaforo 3
                                 .equ S3_G = (1 << 6)
                                 .equ S3_Y = (1 << 7)
                                 .equ S3_R = (1 << 8)
                                 ; Semaforo 4
                                 .equ S4_G = (1 << 9)
                                 .equ S4_Y = (1 << 10)
                                 .equ S4_R = (1 << 11)
                                 ; Semaforo 5
                                 .equ S5_G = (1 << 12)
                                 .equ S5_R = (1 << 13)
                                 
                                 ; Guarda o estado dos leds
                                 mapeamento:
                                 	; Estado 1
000116 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 2
000117 1924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_G 
                                 	; Estado 3
                                 	; O de pedestre pisca
000118 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 4
000119 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 5
00011a 2909                      	.dw S1_G|S2_G|S3_R|S4_R|S5_R
                                 	; Estado 6
00011b 2911                      	.dw S1_G|S2_Y|S3_R|S4_R|S5_R
                                 	; Estado 7
00011c 2921                      	.dw S1_G|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 8
00011d 2321                      	.dw S1_G|S2_R|S3_R|S4_G|S5_R
                                 	; Estado 9
00011e 2522                      	.dw S1_Y|S2_R|S3_R|S4_Y|S5_R
                                 	; Estado 10
00011f 2924                      	.dw S1_R|S2_R|S3_R|S4_R|S5_R
                                 	; Estado 11
000120 2864                      	.dw S1_R|S2_R|S3_G|S4_R|S5_R
                                 	; Estado 12
000121 28a4                      	.dw S1_R|S2_R|S3_Y|S4_R|S5_R
                                 ; #=====================================#
                                 
                                 
                                 ; #==== Mapeamento da quantidade de vezes que vai acontecer as interrupções ====#
                                 qtd_runs:
                                 ; Definindo os limites de execuções, algumas interrupções terão que rodar mais vezes
                                 ; É o caso do estado 2 em que o timer precisa bater 12s mas o maldito timer só sabe contar até 4.2
                                 ; Tive que botar pra repetir no 3 só pra ele ficar piscando D:
                                 ; 1s -> vai rodar 2 vezes de 0.5s
                                 ; 12s -> vai rodar 24 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
                                 ; 2s -> vai rodar 4 vezes de 0.5s
                                 ; 22s -> vai rodar 44 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
                                 ; 1s -> vai rodar 2 vezes de 0.5s
                                 ; 60s -> vai rodar 120 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
                                 ; 25s -> vai rodar 60 vezes de 0.5s
                                 ; 4s -> vai rodar 8 vezes de 0.5s
000122 1701
000123 0307
000124 072b
000125 7701
000126 0107
000127 0731                      .db 1, 23, 7, 3, 43, 7, 1, 119, 7, 1, 49, 7
